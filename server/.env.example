# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

# Added once the database is chosen (CHA-6)
DATABASE_URL=

# Used to sign login tokens (CHA-10). Any long random string.
JWT_SECRET=

# The server's public address, used to build each repo's webhook URL.
# Locally: http://localhost:3000 (GitHub can't reach this; real webhooks need the deployed URL)
PUBLIC_URL=http://localhost:3000
